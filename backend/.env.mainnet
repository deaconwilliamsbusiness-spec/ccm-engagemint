# Server Configuration
PORT=5050
NODE_ENV=production
FRONTEND_URL=https://engagemint.meme

# Database Configuration
# Railway production database
DATABASE_URL=postgresql://postgres:password@host:port/database

# JWT Configuration
JWT_SECRET=ccm_engagemint_production_jwt_secret_ultra_secure_2025_key_minimum_32_chars
JWT_EXPIRE=7d

# Security
BCRYPT_ROUNDS=10

# ============================================
# SOLANA MAINNET CONFIGURATION
# ============================================

# Mainnet RPC - PREMIUM RECOMMENDED
# Public RPC (free but rate-limited):
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Premium RPC (recommended for production):
# Helius: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# QuickNode: https://your-endpoint.quiknode.pro/YOUR_KEY
# Alchemy: https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Backend Wallet - MAINNET
# ⚠️  THIS WALLET HOLDS REAL SOL ⚠️
# Generated wallet: Gr4PTCaP5BDipPhmEa9515hZ2pKu4LDxMkYHKHt3soSx
