# EngageMint Backend Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/ccm_engagemint
# Or individual connection params:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ccm_engagemint
# DB_USER=your_user
# DB_PASSWORD=your_password

# JWT Configuration
JWT_SECRET=your_secure_random_string_here_change_in_production
JWT_EXPIRE=7d
BCRYPT_ROUNDS=10

# Solana Configuration (PATH B: Viral Auto-Launch)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_BACKEND_WALLET_PRIVATE_KEY=<base58_encoded_keypair>

# Viral Monitor Settings
VIRAL_THRESHOLD=10000
VIRAL_CHECK_INTERVAL_MS=60000
AUTO_LAUNCH_ENABLED=true

# Solana Program IDs (update after deployment)
# TOKEN_PROGRAM_ID=<program_id_after_deployment>
# BONDING_CURVE_PROGRAM_ID=<program_id_after_deployment>

# Instructions to generate backend wallet:
# 1. Install Solana CLI: sh -c "$(curl -sSfL https://release.solana.com/stable/install)"
# 2. Generate keypair: solana-keygen new --outfile backend-wallet.json
# 3. Get public key: solana-keygen pubkey backend-wallet.json
# 4. Convert to base58: cat backend-wallet.json | python3 -c "import sys, json, base58; print(base58.b58encode(bytes(json.load(sys.stdin))).decode())"
# 5. Airdrop SOL (devnet): solana airdrop 2 <PUBLIC_KEY> --url devnet
# 6. Copy base58 string to SOLANA_BACKEND_WALLET_PRIVATE_KEY above
