# ============================================
# ENGAGEMINT - DEVNET CONFIGURATION
# ============================================
# Use this for development and testing
# Free SOL from faucets, safe to experiment
# ============================================

# Server Configuration
PORT=5050
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Configuration
# TODO: Replace with your Railway DATABASE_URL
DATABASE_URL=postgresql://postgres:password@host:port/database

# JWT Configuration
JWT_SECRET=ccm_engagemint_dev_jwt_secret_ultra_secure_2025_key_minimum_32_chars
JWT_EXPIRE=7d

# Security
BCRYPT_ROUNDS=10

# ============================================
# SOLANA DEVNET CONFIGURATION
# ============================================

# Devnet RPC (free, for testing)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Backend Wallet - DEVNET
# This wallet will auto-launch tokens for viral videos
# Generate with: solana-keygen new --outfile ~/.config/solana/devnet-wallet.json
# Get base58 key with the command in NEXT_STEPS.md
SOLANA_BACKEND_WALLET_PRIVATE_KEY=YOUR_DEVNET_WALLET_KEY_HERE
# Public Key: EKi3twpzQF74VK2xut7SV5ZuWyJh8kfGhfNSqut6F6Gt (example)

# Viral Auto-Launch Settings (DEVNET - EASIER TESTING)
VIRAL_THRESHOLD=100
# Only need 100 likes to trigger token launch (instead of 10,000)
# Makes testing much faster!

VIRAL_CHECK_INTERVAL_MS=10000
# Check every 10 seconds (instead of 60)
# Faster response for testing

AUTO_LAUNCH_ENABLED=true
# Enable automatic token launches for PATH B

# Network Identifier (for logging)
SOLANA_NETWORK=devnet
