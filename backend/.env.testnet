# ============================================
# ENGAGEMINT - TESTNET CONFIGURATION
# ============================================
# Use this for final testing before mainnet
# Free SOL, more stable than devnet
# Mirrors mainnet performance
# ============================================

# Server Configuration
PORT=5050
NODE_ENV=production
FRONTEND_URL=https://your-frontend.vercel.app

# Database Configuration
# TODO: Replace with your Railway DATABASE_URL
DATABASE_URL=postgresql://postgres:password@host:port/database

# JWT Configuration
JWT_SECRET=ccm_engagemint_production_jwt_secret_ultra_secure_2025_key_minimum_32_chars
JWT_EXPIRE=7d

# Security
BCRYPT_ROUNDS=10

# ============================================
# SOLANA TESTNET CONFIGURATION
# ============================================

# Testnet RPC
SOLANA_RPC_URL=https://api.testnet.solana.com

# Backend Wallet - TESTNET
# Generate with: solana-keygen new --outfile ~/.config/solana/testnet-wallet.json
SOLANA_BACKEND_WALLET_PRIVATE_KEY=YOUR_TESTNET_WALLET_KEY_HERE
# Airdrop testnet SOL: solana airdrop 2 --url testnet

# Viral Auto-Launch Settings (TESTNET - PRODUCTION-LIKE)
VIRAL_THRESHOLD=1000
# Medium threshold for realistic testing (1,000 likes)

VIRAL_CHECK_INTERVAL_MS=30000
# Check every 30 seconds (compromise between dev and prod)

AUTO_LAUNCH_ENABLED=true

# Network Identifier
SOLANA_NETWORK=testnet
